<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="true"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= ROOM IMAGE ================= -->
        <ImageView
            android:id="@+id/imgRoom"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:adjustViewBounds="true"
            android:background="#EEE"
            android:scaleType="centerCrop"
            app:srcCompat="@mipmap/ic_launcher" />

        <!-- ================= STATUS BADGE ================= -->
        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-28dp"
            android:layout_marginEnd="12dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_gravity="end"
            android:text="Available"
            android:textSize="12sp"
            android:textColor="#008000"
            android:background="@drawable/status_paid_bg" />

        <!-- ================= CONTENT AREA ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ROOM NAME + PRICE ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtRoomName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Room R-101"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱5,000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1E5BFF" />
            </LinearLayout>

            <!-- PER MONTH BELOW PRICE -->
            <TextView
                android:id="@+id/txtPerMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="per month"
                android:textColor="#666"
                android:textSize="12sp"
                android:paddingBottom="6dp" />

            <!-- ROOM TYPE -->
            <TextView
                android:id="@+id/txtRoomType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Single Room"
                android:textColor="#555"
                android:textSize="14sp"
                android:paddingBottom="4dp" />

            <!-- CAPACITY ROW -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iconCapacity"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_people"
                    app:tint="#555" />

                <TextView
                    android:id="@+id/txtCapacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="Capacity: 1 person"
                    android:textSize="14sp"
                    android:textColor="#555" />
            </LinearLayout>

            <!-- ================= BUTTONS AREA ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <!-- Manage Button -->
                <Button
                    android:id="@+id/btnManage"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Manage"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/toggle_selected" />

                <!-- Edit Icon Button -->
                <ImageView
                    android:id="@+id/btnEdit"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/black"
                    android:background="@drawable/edittxt_bg_rf" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
