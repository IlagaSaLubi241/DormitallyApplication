<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================= HEADER BAR ================= -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1E5BFF">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                android:layout_centerVertical="true"
                android:src="@drawable/baseline_arrow_back_24" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/backBtn"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:text="Create Account"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="18sp" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <!-- ================= END HEADER BAR ================= -->


    <!-- ================= SCROLLABLE CONTENT ================= -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- YOUR EXISTING CODE STARTS HERE -->
            <!-- (Everything pasted exactly as you sent it below) -->

            <!-- PERSONAL INFORMATION CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp"
                        android:text="Personal Information"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Full Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Name *" />

                    <EditText
                        android:id="@+id/fullName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/edittxt_bg_rf"
                        android:hint="Juan Dela Cruz"
                        android:padding="12dp" />

                    <!-- Gender & Age Side by Side -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- Gender -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gender *" />

                            <Spinner
                                android:id="@+id/spinnerGender"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginBottom="16dp"
                                android:background="@drawable/edittxt_bg_rf"
                                android:entries="@array/Gender" />
                        </LinearLayout>

                        <!-- Age -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Age *" />

                            <EditText
                                android:id="@+id/age"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginBottom="16dp"
                                android:background="@drawable/edittxt_bg_rf"
                                android:hint="25"
                                android:inputType="number"
                                android:padding="12dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Civil Status -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Civil Status *" />

                    <Spinner
                        android:id="@+id/spinnerCivilStatus"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/edittxt_bg_rf"
                        android:entries="@array/CivilStatus" />

                    <!-- address -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Address *" />

                    <EditText
                        android:id="@+id/address"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/edittxt_bg_rf"
                        android:hint="Street, Brgy , City, Province"
                        android:padding="12dp" />

                    <!-- Occupation -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Occupation *" />

                    <EditText
                        android:id="@+id/occupation"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/edittxt_bg_rf"
                        android:hint="Ex. Student,Teacher,Engineer"
                        android:padding="12dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <!-- ACCOUNT CREDENTIALS CARD -->
            <!-- CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Email -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp"
                        android:text="Account Credentials"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email Address *" />

                    <EditText
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/edittxt_bg_rf"
                        android:hint="juan.delacruz@email.com"
                        android:inputType="textEmailAddress"
                        android:padding="12dp" />

                    <!-- Contact Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contact Number *" />


                    <!-- Password -->
                    <EditText
                        android:id="@+id/contactNumber"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/edittxt_bg_rf"
                        android:hint="09*********"
                        android:inputType="text"
                        android:padding="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password *" />

                    <EditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/edittxt_bg_rf"
                        android:hint="Create a strong password"
                        android:inputType="textPassword"
                        android:padding="12dp" />

                    <!-- Confirm Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirm Password *" />

                    <EditText
                        android:id="@+id/confirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/edittxt_bg_rf"
                        android:hint="Confirm Password"
                        android:inputType="textPassword"
                        android:padding="12dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="16dp"
                        android:text="Verification and Intent"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Valid ID label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="6dp"
                        android:text="Valid ID *" />

                    <!-- Upload Box -->
                    <LinearLayout
                        android:id="@+id/uploadBox"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:background="@drawable/dashed_border_box"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/uploadedImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/uploadIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_upload"
                            app:tint="#777" />

                        <TextView
                            android:id="@+id/uploadTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="8dp"
                            android:text="Upload Valid ID"
                            android:textColor="#555"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/uploadSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="2dp"
                            android:text="Driver's License, National ID, Passport, etc."
                            android:textColor="#999"
                            android:textSize="12sp" />

                    </LinearLayout>


                    <!-- Why interested label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="20dp"
                        android:paddingBottom="6dp"
                        android:text="Why are you interested in renting? *" />

                    <!-- Textbox -->
                    <EditText
                        android:id="@+id/intentText"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:background="@drawable/edittxt_bg_rf"
                        android:gravity="top|start"
                        android:hint="Tell us why you want to rent a room at our dormitory..."
                        android:padding="16dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!--Room-->
            <!-- ================= ROOM SELECTION ================= -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/textRoomTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Room"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- ================= EMPTY STATE (Choose a Room) ================= -->
                    <LinearLayout
                        android:id="@+id/noRoomContainer"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/dashed_border_box"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_home"
                            app:tint="#777" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="8dp"
                            android:text="No room selected"
                            android:textColor="#444"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap here to choose a room"
                            android:textColor="#888"
                            android:textSize="12dp" />
                    </LinearLayout>

                    <!-- ================= SELECTED ROOM DETAILS ================= -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/roomDetailsCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/roomImage"
                                android:layout_width="match_parent"
                                android:layout_height="160dp"
                                android:scaleType="centerCrop"
                                tools:srcCompat="@tools:sample/backgrounds/scenic" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="12dp">

                                <!-- LEFT SIDE -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/roomNum"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Room R-101"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/roomType"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingTop="2dp"
                                        android:text="Single Room"
                                        android:textColor="#666" />

                                    <TextView
                                        android:id="@+id/roomCapacity"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingTop="2dp"
                                        android:text="Capacity: 1 person"
                                        android:textColor="#666" />
                                </LinearLayout>

                                <!-- RIGHT SIDE PRICE -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/roomPrice"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="₱5,000"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/pricePer"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="per month"
                                        android:textColor="#666" />
                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/submitBtn"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Submit Application"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:background="@drawable/toggle_selected"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp" />
        </LinearLayout>
    </ScrollView>
    <!-- ================= END SCROLLABLE CONTENT ================= -->

</LinearLayout>
